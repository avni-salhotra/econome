# ===================================
# ECONOME - ENVIRONMENT CONFIGURATION
# ===================================
# Copy this file to .env and configure for your environment
# NEVER commit .env files to version control!

# ===================================
# GOOGLE CLOUD CONFIGURATION
# ===================================

# Your Google Cloud Project ID (required)
GOOGLE_CLOUD_PROJECT=your-project-id-here

# Google Cloud Region for services
GOOGLE_CLOUD_REGION=us-central1

# ===================================
# AUTHENTICATION & CREDENTIALS
# ===================================

# Local Development: Path to service account key file
GOOGLE_APPLICATION_CREDENTIALS=./speech-credentials.json

# Speech-to-Text credentials (local development)
SPEECH_CREDENTIALS_PATH=./speech-credentials.json

# Gemini AI credentials (local development)
GEMINI_CREDENTIALS_PATH=./gemini-credentials.json

# Production: Credentials are managed via Google Secret Manager
# No need to set these in production Cloud Run environment

# ===================================
# APPLICATION CONFIGURATION
# ===================================

# Server configuration
PORT=8080
HOST=0.0.0.0

# Application environment
ENVIRONMENT=development
# Options: development, staging, production

# Base URL for the application (used for generating links)
BASE_URL=http://localhost:8080
# Production example: https://your-service-url.run.app

# ===================================
# SPEECH-TO-TEXT CONFIGURATION
# ===================================

# Audio configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Audio chunk duration in seconds (recommended: 2.0)
STT_CHUNK_DURATION=2.0

# Speech recognition language code
STT_LANGUAGE_CODE=en-US

# Enable enhanced speech models (costs more but better accuracy)
STT_USE_ENHANCED=true

# ===================================
# GEMINI AI CONFIGURATION
# ===================================

# Gemini model to use
GEMINI_MODEL=gemini-1.5-pro

# Temperature for AI responses (0.0-1.0, lower = more focused)
GEMINI_TEMPERATURE=0.3

# Maximum tokens for AI responses
GEMINI_MAX_TOKENS=2048

# ===================================
# SESSION MANAGEMENT
# ===================================

# Session timeout in hours (24 hours for privacy compliance)
SESSION_TIMEOUT_HOURS=24

# Maximum concurrent sessions per instance
MAX_CONCURRENT_SESSIONS=100

# ===================================
# WEBSOCKET CONFIGURATION
# ===================================

# WebSocket settings
WS_MAX_CONNECTIONS=100
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
WEBSOCKET_TIMEOUT=300

# ===================================
# SECURITY CONFIGURATION
# ===================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*
# Production: CORS_ORIGINS=https://your-domain.com,https://your-app.run.app

# Secret key for session tokens (generate a secure random string)
SECRET_KEY=your-secret-key-here-generate-a-secure-random-string

# Enable HTTPS redirect in production
FORCE_HTTPS=false

# ===================================
# LOGGING & MONITORING
# ===================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed logging for debugging
DEBUG_MODE=false

# Google Cloud Logging (automatically enabled in Cloud Run)
ENABLE_CLOUD_LOGGING=true

# ===================================
# PERFORMANCE TUNING
# ===================================

# Maximum audio file size (MB)
MAX_AUDIO_SIZE_MB=50

# Audio processing queue size
AUDIO_QUEUE_SIZE=10

# ===================================
# DEVELOPMENT SETTINGS
# ===================================

# Enable mock mode (no Google Cloud services required)
MOCK_MODE=false

# Auto-reload on code changes (development only)
AUTO_RELOAD=true

# Enable API documentation at /docs
ENABLE_API_DOCS=true

# ===================================
# CLOUD RUN SPECIFIC
# ===================================
# These are set automatically in production

K_SERVICE=econome
K_REVISION=
K_CONFIGURATION=

# ===================================
# OPTIONAL INTEGRATIONS
# ===================================

# Firestore database ID (default uses project default)
FIRESTORE_DATABASE_ID=(default)

# Custom domain for the application
CUSTOM_DOMAIN=

# Analytics tracking ID (if using Google Analytics)
ANALYTICS_ID=
