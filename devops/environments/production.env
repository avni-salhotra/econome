# ===================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================
# Configuration specific to production environment
# Inherits from common.env and overrides as needed

# ===================================
# ENVIRONMENT IDENTIFICATION
# ===================================
ENVIRONMENT=production
ENVIRONMENT_TYPE=production
DEPLOYMENT_STAGE=production

# ===================================
# SERVICE CONFIGURATION
# ===================================
SERVICE_NAME=econome
SERVICE_DISPLAY_NAME="Econome Production"

# ===================================
# RESOURCE ALLOCATION (FULL PRODUCTION)
# ===================================
# Memory allocation
MEMORY=2Gi
MEMORY_LIMIT=2Gi

# CPU allocation
CPU=2
CPU_LIMIT=2

# ===================================
# SCALING CONFIGURATION (PRODUCTION READY)
# ===================================
# Concurrency (requests per instance)
CONCURRENCY=100
MAX_CONCURRENCY=100

# Instance scaling
MIN_INSTANCES=1
MAX_INSTANCES=10

# ===================================
# TIMEOUT CONFIGURATION (EXTENDED)
# ===================================
# Request timeout (1 hour for long conversations)
TIMEOUT=3600
REQUEST_TIMEOUT=3600

# Startup timeout
STARTUP_TIMEOUT=240

# ===================================
# PERFORMANCE CONFIGURATION
# ===================================
# CPU throttling (disabled for better performance)
CPU_THROTTLING=false

# Execution environment
EXECUTION_ENVIRONMENT=gen2

# ===================================
# LOGGING CONFIGURATION
# ===================================
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGS=false
LOG_FORMAT=json

# ===================================
# MONITORING CONFIGURATION
# ===================================
# Health check configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===================================
# DEPLOYMENT CONFIGURATION
# ===================================
# Traffic allocation
TRAFFIC_PERCENT=100

# Revision naming
REVISION_SUFFIX=prod

# Deployment strategy
DEPLOYMENT_STRATEGY=blue-green

# ===================================
# SECURITY CONFIGURATION
# ===================================
# Allow unauthenticated access (for public app)
ALLOW_UNAUTHENTICATED=true

# CORS configuration (restrictive for production)
CORS_ORIGINS=https://econome-*.a.run.app,https://econome.app
CORS_METHODS=GET,POST,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# ===================================
# FEATURE FLAGS (PRODUCTION SPECIFIC)
# ===================================
# Production feature configuration
ENABLE_API_DOCS=true
ENABLE_SWAGGER_UI=true
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_METRICS_ENDPOINT=true

# ===================================
# PRODUCTION HARDENING
# ===================================
# Disable test modes
ENABLE_TEST_MODE=false
ENABLE_MOCK_SERVICES=false
ENABLE_INTEGRATION_TESTS=false

# ===================================
# DATA CONFIGURATION
# ===================================
# Full TTL for production data
SESSION_TTL_HOURS=24
AUTO_DELETE_SESSIONS=true

# Database configuration (if applicable)
# DATABASE_POOL_SIZE=20
# DATABASE_TIMEOUT=60

# ===================================
# NOTIFICATION CONFIGURATION
# ===================================
# Production-specific notifications
ENABLE_DEPLOYMENT_NOTIFICATIONS=true
NOTIFICATION_CHANNEL=production
ENABLE_ALERT_NOTIFICATIONS=true

# ===================================
# PRODUCTION FEATURES
# ===================================
# Disable development features
ENABLE_HOT_RELOAD=false
ENABLE_PROFILING=false
ENABLE_TRACING=true

# ===================================
# ENVIRONMENT VARIABLES FOR CLOUD RUN
# ===================================
# These will be passed to the Cloud Run service
CLOUD_RUN_ENV_VARS=GOOGLE_CLOUD_PROJECT=econome-hackathon,PORT=8080,ENVIRONMENT=production,LOG_LEVEL=INFO

# ===================================
# TAGS AND LABELS
# ===================================
# Service tags for organization
SERVICE_TAGS=environment:production,type:web-service,team:econome,critical:true

# Labels for Cloud Run service
SERVICE_LABELS=environment=production,application=econome,tier=production

# ===================================
# BACKUP AND RECOVERY
# ===================================
# Backup configuration (full for production)
ENABLE_BACKUPS=true
BACKUP_RETENTION_DAYS=30
BACKUP_FREQUENCY=daily

# ===================================
# HIGH AVAILABILITY
# ===================================
# High availability settings
ENABLE_HIGH_AVAILABILITY=true
MULTI_REGION_DEPLOYMENT=false
DISASTER_RECOVERY_ENABLED=true

# ===================================
# PERFORMANCE OPTIMIZATION
# ===================================
# Performance-optimized settings
ENABLE_PERFORMANCE_OPTIMIZATION=true
ENABLE_CACHING=true
CACHE_TTL=3600

# ===================================
# PRODUCTION URLS
# ===================================
# Expected production URL pattern
PRODUCTION_URL_PATTERN=https://econome-*.a.run.app

# Custom domain (if configured)
# CUSTOM_DOMAIN=econome.app

# ===================================
# SECURITY HARDENING
# ===================================
# Additional security for production
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# ===================================
# COMPLIANCE AND AUDITING
# ===================================
# Compliance settings
ENABLE_AUDIT_LOGGING=true
ENABLE_COMPLIANCE_MONITORING=true
DATA_RESIDENCY=us-central1

# ===================================
# DEPLOYMENT VALIDATION
# ===================================
# Strict validation for production deployments
ENABLE_DEPLOYMENT_VALIDATION=true
VALIDATION_TIMEOUT=600
HEALTH_CHECK_RETRIES=10
REQUIRE_MANUAL_APPROVAL=true

# ===================================
# ROLLBACK CONFIGURATION
# ===================================
# Conservative rollback settings
ENABLE_AUTO_ROLLBACK=true
ROLLBACK_THRESHOLD_ERROR_RATE=5
ROLLBACK_THRESHOLD_LATENCY=3000

# ===================================
# ALERTING CONFIGURATION
# ===================================
# Production alerting
ENABLE_ERROR_ALERTING=true
ENABLE_LATENCY_ALERTING=true
ENABLE_AVAILABILITY_ALERTING=true

# Error rate thresholds
ERROR_RATE_THRESHOLD=1
LATENCY_THRESHOLD=2000
AVAILABILITY_THRESHOLD=99.9

# ===================================
# CAPACITY PLANNING
# ===================================
# Capacity planning settings
ENABLE_CAPACITY_MONITORING=true
SCALE_UP_THRESHOLD=80
SCALE_DOWN_THRESHOLD=20

# ===================================
# MAINTENANCE WINDOWS
# ===================================
# Maintenance configuration
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00
MAINTENANCE_TIMEZONE=UTC

# ===================================
# SLA CONFIGURATION
# ===================================
# Service Level Agreement targets
SLA_AVAILABILITY_TARGET=99.9
SLA_LATENCY_TARGET=1000
SLA_ERROR_RATE_TARGET=0.1
