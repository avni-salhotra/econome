# ===================================
# COMMON ENVIRONMENT CONFIGURATION
# ===================================
# Shared configuration across all environments
# These values are used by both staging and production

# ===================================
# PROJECT CONFIGURATION
# ===================================
PROJECT_ID=econome-hackathon
REGION=us-central1
REGISTRY=gcr.io

# ===================================
# APPLICATION CONFIGURATION
# ===================================
APP_NAME=econome
APP_VERSION=1.0.0
APP_DESCRIPTION="Privacy-first conversation intelligence system"

# ===================================
# CONTAINER CONFIGURATION
# ===================================
CONTAINER_PORT=8080
PLATFORM=managed

# ===================================
# SECURITY CONFIGURATION
# ===================================
# Service account for Cloud Run
SERVICE_ACCOUNT_EMAIL=econome-builder@econome-hackathon.iam.gserviceaccount.com

# Secret Manager secrets
SPEECH_CREDENTIALS_SECRET=speech-credentials:latest
GEMINI_CREDENTIALS_SECRET=gemini-credentials:latest

# Secret mount paths
SPEECH_CREDENTIALS_PATH=/app/secrets/speech-credentials.json
GEMINI_CREDENTIALS_PATH=/app/secrets/gemini-credentials.json

# ===================================
# NETWORKING CONFIGURATION
# ===================================
ALLOW_UNAUTHENTICATED=true
INGRESS=all

# ===================================
# MONITORING CONFIGURATION
# ===================================
ENABLE_CLOUD_LOGGING=true
ENABLE_CLOUD_MONITORING=true
ENABLE_CLOUD_TRACE=true

# ===================================
# APPLICATION ENVIRONMENT VARIABLES
# ===================================
# These will be set for all environments
GOOGLE_CLOUD_PROJECT=econome-hackathon
PORT=8080
PYTHONUNBUFFERED=1

# ===================================
# HEALTH CHECK CONFIGURATION
# ===================================
HEALTH_CHECK_PATH=/health
STARTUP_TIMEOUT=240
LIVENESS_TIMEOUT=30

# ===================================
# BUILD CONFIGURATION
# ===================================
DOCKERFILE_PATH=devops/Dockerfile
BUILD_TIMEOUT=1200s
MACHINE_TYPE=E2_HIGHCPU_8

# ===================================
# ARTIFACT STORAGE
# ===================================
ARTIFACT_BUCKET_PREFIX=econome-hackathon-build-artifacts
LOG_RETENTION_DAYS=30

# ===================================
# NOTIFICATION CONFIGURATION
# ===================================
# Slack webhook URL (if configured)
# SLACK_WEBHOOK_URL=

# Email notifications (if configured)
# NOTIFICATION_EMAIL=

# ===================================
# FEATURE FLAGS
# ===================================
ENABLE_API_DOCS=true
ENABLE_CORS=true
ENABLE_WEBSOCKETS=true

# ===================================
# PRIVACY CONFIGURATION
# ===================================
# Session TTL (24 hours)
SESSION_TTL_HOURS=24
AUTO_DELETE_SESSIONS=true
PRIVACY_MODE=strict

# ===================================
# PERFORMANCE CONFIGURATION
# ===================================
# Default timeout for requests
REQUEST_TIMEOUT=30
WEBSOCKET_TIMEOUT=3600

# ===================================
# DEVELOPMENT CONFIGURATION
# ===================================
# Mock mode for testing
MOCK_MODE=false
DEBUG_MODE=false
