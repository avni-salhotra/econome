# ===================================
# STAGING ENVIRONMENT CONFIGURATION
# ===================================
# Configuration specific to staging environment
# Inherits from common.env and overrides as needed

# ===================================
# ENVIRONMENT IDENTIFICATION
# ===================================
ENVIRONMENT=staging
ENVIRONMENT_TYPE=staging
DEPLOYMENT_STAGE=staging

# ===================================
# SERVICE CONFIGURATION
# ===================================
SERVICE_NAME=econome-staging
SERVICE_DISPLAY_NAME="Econome Staging"

# ===================================
# RESOURCE ALLOCATION (REDUCED FOR STAGING)
# ===================================
# Memory allocation
MEMORY=1Gi
MEMORY_LIMIT=1Gi

# CPU allocation
CPU=1
CPU_LIMIT=1

# ===================================
# SCALING CONFIGURATION (CONSERVATIVE)
# ===================================
# Concurrency (requests per instance)
CONCURRENCY=50
MAX_CONCURRENCY=50

# Instance scaling
MIN_INSTANCES=0
MAX_INSTANCES=3

# ===================================
# TIMEOUT CONFIGURATION (REDUCED)
# ===================================
# Request timeout (30 minutes)
TIMEOUT=1800
REQUEST_TIMEOUT=1800

# Startup timeout
STARTUP_TIMEOUT=180

# ===================================
# PERFORMANCE CONFIGURATION
# ===================================
# CPU throttling (disabled for better performance)
CPU_THROTTLING=false

# Execution environment
EXECUTION_ENVIRONMENT=gen2

# ===================================
# LOGGING CONFIGURATION
# ===================================
LOG_LEVEL=INFO
ENABLE_DEBUG_LOGS=true
LOG_FORMAT=json

# ===================================
# MONITORING CONFIGURATION
# ===================================
# Health check configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===================================
# DEPLOYMENT CONFIGURATION
# ===================================
# Traffic allocation
TRAFFIC_PERCENT=100

# Revision naming
REVISION_SUFFIX=staging

# Deployment strategy
DEPLOYMENT_STRATEGY=rolling

# ===================================
# SECURITY CONFIGURATION
# ===================================
# Allow unauthenticated access for testing
ALLOW_UNAUTHENTICATED=true

# CORS configuration (permissive for staging)
CORS_ORIGINS=*
CORS_METHODS=*
CORS_HEADERS=*

# ===================================
# FEATURE FLAGS (STAGING SPECIFIC)
# ===================================
# Enable all features for testing
ENABLE_API_DOCS=true
ENABLE_SWAGGER_UI=true
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_METRICS_ENDPOINT=true

# ===================================
# TESTING CONFIGURATION
# ===================================
# Enable test modes
ENABLE_TEST_MODE=true
ENABLE_MOCK_SERVICES=false
ENABLE_INTEGRATION_TESTS=true

# ===================================
# DATA CONFIGURATION
# ===================================
# Shorter TTL for staging data
SESSION_TTL_HOURS=12
AUTO_DELETE_SESSIONS=true

# Database configuration (if applicable)
# DATABASE_POOL_SIZE=5
# DATABASE_TIMEOUT=30

# ===================================
# NOTIFICATION CONFIGURATION
# ===================================
# Staging-specific notifications
ENABLE_DEPLOYMENT_NOTIFICATIONS=true
NOTIFICATION_CHANNEL=staging

# ===================================
# DEVELOPMENT FEATURES
# ===================================
# Enable development features
ENABLE_HOT_RELOAD=false
ENABLE_PROFILING=true
ENABLE_TRACING=true

# ===================================
# ENVIRONMENT VARIABLES FOR CLOUD RUN
# ===================================
# These will be passed to the Cloud Run service
CLOUD_RUN_ENV_VARS=GOOGLE_CLOUD_PROJECT=econome-hackathon,PORT=8080,ENVIRONMENT=staging,LOG_LEVEL=INFO

# ===================================
# TAGS AND LABELS
# ===================================
# Service tags for organization
SERVICE_TAGS=environment:staging,type:web-service,team:econome

# Labels for Cloud Run service
SERVICE_LABELS=environment=staging,application=econome,tier=staging

# ===================================
# BACKUP AND RECOVERY
# ===================================
# Backup configuration (minimal for staging)
ENABLE_BACKUPS=false
BACKUP_RETENTION_DAYS=7

# ===================================
# COST OPTIMIZATION
# ===================================
# Cost-optimized settings for staging
ENABLE_COST_OPTIMIZATION=true
PREEMPTIBLE_INSTANCES=false

# ===================================
# STAGING-SPECIFIC URLS
# ===================================
# Expected staging URL pattern
STAGING_URL_PATTERN=https://econome-staging-*.a.run.app

# ===================================
# TESTING ENDPOINTS
# ===================================
# Additional endpoints for staging testing
ENABLE_TEST_ENDPOINTS=true
TEST_ENDPOINT_PREFIX=/test

# ===================================
# DEPLOYMENT VALIDATION
# ===================================
# Validation settings for staging deployments
ENABLE_DEPLOYMENT_VALIDATION=true
VALIDATION_TIMEOUT=300
HEALTH_CHECK_RETRIES=5

# ===================================
# ROLLBACK CONFIGURATION
# ===================================
# Automatic rollback settings
ENABLE_AUTO_ROLLBACK=true
ROLLBACK_THRESHOLD_ERROR_RATE=10
ROLLBACK_THRESHOLD_LATENCY=5000
